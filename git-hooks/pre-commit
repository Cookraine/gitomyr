#!/bin/bash
echo "⏳ Запуск перевірки стилю коду (Laravel Pint)..."

# Перевірка, чи взагалі є доступ до Docker
if ! docker info > /dev/null 2>&1; then
    echo "❌ Помилка: Немає доступу до Docker API. Перевір права користувача."
    exit 1
fi

# Перевірка контейнера
if docker ps --format '{{.Names}}' | grep -q "^gitomyr.app$"; then
    docker exec gitomyr.app ./vendor/bin/pint --test
    if [ $? -ne 0 ]; then
        echo "❌ Помилка: Стиль коду не відповідає стандартам."
        exit 1
    fi
else
    echo "⚠️ Контейнер gitomyr.app не запущено. Запусти його через 'docker-compose up -d'."
    exit 1 # Блокуємо коміт, щоб гарантувати перевірку
fi
